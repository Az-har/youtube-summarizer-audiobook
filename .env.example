# Local Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Whisper Speech-to-Text Model (large-v3, large-v2, medium, small, base)
WHISPER_MODEL=large-v3
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8

# Neural Audiobook TTS Engine (edge, command, none)
TTS_PROVIDER=edge
TTS_VOICE_TAMIL=ta-IN-ValluvarNeural
TTS_VOICE_ENGLISH=en-US-ChristopherNeural
TTS_COMMAND_TEMPLATE=

# System Binaries
FFMPEG_BINARY=ffmpeg
YTDLP_BINARY=yt-dlp
