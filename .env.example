# Local Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Whisper Speech-to-Text Model (large-v3, large-v2, medium, small, base)
WHISPER_MODEL=large-v3
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8

# Neural Audiobook TTS Engine (kokoro, edge, command, none)
TTS_PROVIDER=kokoro
KOKORO_VOICE=af_heart
KOKORO_SPEED=1.0
TTS_VOICE_TAMIL=ta-IN-ValluvarNeural
TTS_VOICE_ENGLISH=en-US-ChristopherNeural
TTS_COMMAND_TEMPLATE=

# System Binaries
FFMPEG_BINARY=ffmpeg
YTDLP_BINARY=yt-dlp

# Notion Second Brain Ingestion & Sync
NOTION_API_KEY=
NOTION_DATABASE_ID=
NOTION_PAGE_ID=
NOTION_SYNC_ENABLED=false

# YouTube Music Podcast Publisher (youtube_video, rss, ytmusic_library, none)
PODCAST_PUBLISHER_MODE=youtube_video
PODCAST_AUTHOR=Azhar
PODCAST_PLAYLIST_NAME=Azhar's AI Audiobooks
YOUTUBE_PODCAST_PLAYLIST_ID=
YOUTUBE_PRIVACY_STATUS=unlisted
YOUTUBE_CLIENT_SECRET_FILE=client_secret.json

